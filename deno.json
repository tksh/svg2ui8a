{
  "name": "@tksh/svg2ui8a",
  "version": "0.1.1",
  "exports": {
    ".": "./src/mod.ts",
    "./usvg": "./src/usvg.ts",
    "./rgba": "./src/rgba.ts"
  },
  "publish": {
    "exclude": [
      "AGENTS.md",
      "task.md",
      "docs/**",
      "notes/**",
      "crates/**",
      "scripts/**",
      "tests/**",
      "Cargo.toml",
      "Cargo.lock",
      ".gitignore",
      ".git",
      ".git/**",
      ".githooks/**",
      "deno.lock"
    ]
  },
  "imports": {
    "@astral/astral": "jsr:@astral/astral@0.5.6"
  },
  "tasks": {
    "build": "deno run -A scripts/build.ts",
    "test": "deno task test:rust && deno task test:wasm && deno task test:wasm:browser && deno test -A",
    "test:rust": "cd crates/svg2usvg && cargo test && cd ../usvg2rgba && cargo test",
    "test:wasm": "deno run -A scripts/test-wasm.ts",
    "test:wasm:browser": "deno run -A scripts/test-wasm-browser.ts",
    "ensure:chrome": "deno run -A scripts/ensure-chrome.ts",
    "fixtures:regen": "cargo run --quiet --release -p svg2usvg --example dump_core < tests/fixtures/straightlines-sample.svg > tests/fixtures/straightlines-sample.cbor",
    "fmt": "cargo fmt && deno fmt",
    "lint": "deno lint",
    "check": "deno check src/**/*.ts tests/**/*.ts scripts/*.ts"
  }
}
